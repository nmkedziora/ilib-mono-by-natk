{
    "source": {
        "include": ["packages/ilib-common/src", "packages/ilib-po/src"],
        "includePattern": ".+\\.(js|ts|jsx|tsx)$",
        "excludePattern": "(node_modules/|docs/|build/)"
    },
    "plugins": ["plugins/markdown"],
    "sourceType": "module",
    "tags": {
        "allowUnknownTags": true
    },
    "opts": {
        "encoding": "utf8",
        "recurse": true
    },
    "linenums": true,
    "sort": true,
    "search": true,
} 





