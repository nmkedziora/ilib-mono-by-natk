{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./packages/ilib-po/src/index.ts",
    "./packages/ilib-common/src/index.js"
  ],
  "entryPointStrategy": "expand",
  "out": "./lolkek",
  "plugin": ["typedoc-plugin-markdown"],
  "cleanOutputDir": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "skipErrorChecking": true,
  "compilerOptions": {"skipLibCheck": true},
  "tsconfig": "./typedoc.tsconfig.json",
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": false
  },
  "jsDocCompatibility": true,
  "treatWarningsAsErrors": false,
  "readme": "none",
  "disableSources": true,
  "groupOrder": ["Classes", "Interfaces", "Functions", "Variables", "Type Aliases"],
  "githubPages": false,
  "hideBreadcrumbs": true,
  "hidePageTitle": true,
  "useCodeBlocks": true,
  "disableGit": true,
  "outputFileStrategy": "modules"
}
